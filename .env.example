# --- Email (Resend) ---
# Creá una cuenta gratuita en https://resend.com y generá un API key.
# Free tier: 3000 emails/mes, 100/día.
RESEND_API_KEY=

# Dirección desde la que salen los emails (debe ser un dominio verificado en Resend).
# Para desarrollo podés usar: onboarding@resend.dev
EMAIL_FROM=Vertix <notificaciones@vertix.com.ar>

# Dirección interna que recibe las notificaciones de cada formulario.
EMAIL_TO=info@vertix.com.ar

# --- Google Sheets (tasas) ---
# La hoja "tasas" tiene una fila por tramo, con la TNA ANUAL en %. La tasa de
# descuento y los gastos van separados para poder ajustar una sin la otra.
# El plazo se mide en días hasta la acreditación del comprador.
#
#   directo_hasta_45        | 48    (cheque o echeq directo con Vertix)
#   gastos_directo_hasta_45 | 2
#   directo_desde_46        | 72
#   gastos_directo_desde_46 | 3,5
#   comitente_hasta_30      | 40    (echeq por cuenta comitente)
#   comitente_31_60         | 43
#   comitente_desde_61      | 45
#   comitente_fce           | 40    (la FCE no tiene tramos: es estimativa)
#   arancel_comitente       | 2,5   (aplica a toda la cuenta comitente)
#   prestamos_ph            | 72    (un extremo del rango de préstamos)
#   prestamos_pj            | 82    (el otro; la tasa final depende del
#                                    solicitante y del mercado)
#
# Además hay filas OPCIONALES con los costos de la operación. Si faltan se usan
# estos mismos valores, así que sólo hace falta cargarlas para cambiarlas:
#
#   iva                     | 21    (IVA general, mercado de capitales)
#   iva_directo             | 21    (IVA fuera del mercado, sobre todos los gastos)
#   derechos_mercado        | 0,06  (derechos del VENDEDOR)
#   derechos_comprador      | 0,03  (derechos del COMPRADOR: la mitad)
#   arancel_comprador       | 0     (arancel de la ALyC al comprador)
#   ingresos_brutos         | 9     (sobre el interés, fuera del mercado)
#   impuesto_cheque         | 1,2   (si vence en menos de 10 días hábiles)
#   arancel_minimo          | 500   (piso EN PESOS del arancel, sólo comitente)
#   gastos_comitente_fce    | 12    (arancel anual de la FCE; el 40% es 28 + 12)
#
# Verificar con: npm run check:sheets
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CRM_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- HubSpot (CRM) ---
# Vacío por ahora — se activa cuando creen la cuenta.
HUBSPOT_API_KEY=

# --- BCRA (Central de Deudores) ---
# Verificación de situación crediticia del librador (API pública, sin key).
# Poné "false" para desactivar el chequeo/bloqueo. Por defecto está activo.
BCRA_CHECK_ENABLED=true

# --- Almacenamiento de adjuntos (Cloudflare R2 o cualquier bucket S3) ---
# Sin estas variables la web sigue funcionando: los documentos viajan dentro
# del formulario y sólo por email (sin copia recuperable). Con ellas, el
# navegador los sube directo al bucket y en el CRM quedan los enlaces.
#
# En Cloudflare: R2 → Create bucket (privado, sin acceso público) →
# Manage API tokens → Create token con permiso "Object Read & Write" sobre ese
# bucket. El endpoint figura en la ficha del bucket como S3 API.
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 ignora la región; dejar "auto" salvo que se use S3 real.
S3_REGION=auto

# Secreto con el que se firman los enlaces de descarga del legajo. Cualquier
# cadena larga y aleatoria (por ejemplo: openssl rand -hex 32).
# Si se cambia, los enlaces ya guardados en el CRM dejan de funcionar.
ADJUNTOS_SECRET=

# URL pública del sitio, para armar esos enlaces (sin barra final).
APP_URL=https://www.vertix.com.ar
